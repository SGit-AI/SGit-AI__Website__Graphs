{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://graphs.sgit.ai/vaults/aiuc-1/schemas/aiuc1-catalog.schema.json",
 "title": "AIUC-1 derived catalog release",
 "description": "One release artefact: the control set as published at one AIUC-1 release, with the sources it was derived from.",
 "type": "object",
 "required": ["catalog_id", "catalog_schema_version", "standard", "release", "controls",
              "change_events", "provenance", "validation"],
 "properties": {
  "$schema": {"type": "string"},
  "catalog_id": {"const": "aiuc-1-derived-catalog"},
  "catalog_schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "standard": {
   "type": "object",
   "required": ["id", "official_website", "official_changelog_repository", "disclaimer"],
   "properties": {
    "id": {"const": "AIUC-1"},
    "name": {"type": "string"},
    "official_website": {"type": "string"},
    "official_changelog_url": {"type": "string"},
    "official_changelog_repository": {"type": "string"},
    "disclaimer": {"type": "string", "minLength": 40}
   }
  },
  "terminology": {"type": "object"},
  "release": {
   "type": "object",
   "required": ["release_id", "published_at", "retrieved_at", "status", "source_commit"],
   "properties": {
    "release_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "published_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "published_label": {"type": "string"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["validated", "needs_review", "partial", "archived"]},
    "built_from": {"type": "string"},
    "official_changelog_url": {"type": ["string", "null"]},
    "source_commit": {
     "type": ["object", "null"],
     "required": ["repository", "sha", "committed_at", "url", "confidence", "rationale"],
     "properties": {
      "repository": {"type": "string"},
      "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "short_sha": {"type": "string"},
      "committed_at": {"type": "string"},
      "url": {"type": "string"},
      "subject": {"type": "string"},
      "files": {"type": "object"},
      "confidence": {"type": "number"},
      "rationale": {"type": "string", "minLength": 20}
     }
    }
   }
  },
  "domains": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "name", "official_url", "source_refs"],
    "properties": {
     "id": {"type": "string", "pattern": "^[A-Z]$"},
     "name": {"type": "string"},
     "slug": {"type": "string"},
     "url": {"type": "string"},
     "official_url": {"type": "string"},
     "description": {"type": ["string", "null"]},
     "control_ids": {"type": "array", "items": {"type": "string"}},
     "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
   }
  },
  "controls": {"type": "array", "items": {"$ref": "aiuc1-control.schema.json"}},
  "change_events": {"type": "array", "items": {"$ref": "aiuc1-change-event.schema.json"}},
  "provenance": {
   "type": "object",
   "required": ["generator_version", "generated_at", "source_manifest", "content_hash"],
   "properties": {
    "generator_version": {"type": "string"},
    "parser_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_manifest": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
   }
  },
  "validation": {
   "type": "object",
   "required": ["schema_valid", "source_traceability_valid", "unresolved_items"],
   "properties": {
    "schema_valid": {"type": ["boolean", "null"]},
    "source_traceability_valid": {"type": ["boolean", "null"]},
    "reconciliation_findings": {"type": "integer"},
    "blocking_findings": {"type": "integer"},
    "unresolved_items": {"type": "array"}
   }
  }
 }
}

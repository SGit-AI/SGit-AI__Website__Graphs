{"sec": "sec:What the System Never Does", "blocks": [{"id": "blk:What the System Never Does/1", "kind": "para", "range": [27505, 27522], "text": "The system never:", "sentences": [{"n": 1, "text": "The system never:", "words": ["The", "system", "never"]}], "spans": []}, {"id": "blk:What the System Never Does/2", "kind": "item", "range": [27524, 27572], "text": "Rejects a node for lacking type conformity", "sentences": [{"n": 1, "text": "Rejects a node for lacking type conformity", "words": ["Rejects", "a", "node", "for", "lacking", "type", "conformity"]}], "spans": [{"id": "mk:What the System Never Does/2.1", "kind": "bold", "covers": ["wrd:What the System Never Does/2.1.1", "wrd:What the System Never Does/2.1.2", "wrd:What the System Never Does/2.1.3"]}]}, {"id": "blk:What the System Never Does/3", "kind": "item", "range": [27573, 27611], "text": "Forces a vocabulary on any scope", "sentences": [{"n": 1, "text": "Forces a vocabulary on any scope", "words": ["Forces", "a", "vocabulary", "on", "any", "scope"]}], "spans": [{"id": "mk:What the System Never Does/3.1", "kind": "bold", "covers": ["wrd:What the System Never Does/3.1.1", "wrd:What the System Never Does/3.1.2", "wrd:What the System Never Does/3.1.3"]}]}, {"id": "blk:What the System Never Does/4", "kind": "item", "range": [27612, 27662], "text": "Assumes meaning where edges don't support it", "sentences": [{"n": 1, "text": "Assumes meaning where edges don't support it", "words": ["Assumes", "meaning", "where", "edges", "don't", "support", "it"]}], "spans": [{"id": "mk:What the System Never Does/4.1", "kind": "bold", "covers": ["wrd:What the System Never Does/4.1.1", "wrd:What the System Never Does/4.1.2"]}]}, {"id": "blk:What the System Never Does/5", "kind": "item", "range": [27663, 27713], "text": "Hides uncertainty behind default assumptions", "sentences": [{"n": 1, "text": "Hides uncertainty behind default assumptions", "words": ["Hides", "uncertainty", "behind", "default", "assumptions"]}], "spans": [{"id": "mk:What the System Never Does/5.1", "kind": "bold", "covers": ["wrd:What the System Never Does/5.1.1", "wrd:What the System Never Does/5.1.2"]}]}, {"id": "blk:What the System Never Does/6", "kind": "item", "range": [27714, 27781], "text": "Requires registration of local vocabulary with a parent scope", "sentences": [{"n": 1, "text": "Requires registration of local vocabulary with a parent scope", "words": ["Requires", "registration", "of", "local", "vocabulary", "with", "a", "parent", "scope"]}], "spans": [{"id": "mk:What the System Never Does/6.1", "kind": "bold", "covers": ["wrd:What the System Never Does/6.1.1", "wrd:What the System Never Does/6.1.2"]}]}, {"id": "blk:What the System Never Does/7", "kind": "item", "range": [27782, 27939], "text": "Treats any node as authoritative by virtue of its source alone — authority is a property of connectivity, provenance, and governance, not of identity", "sentences": [{"n": 1, "text": "Treats any node as authoritative by virtue of its source alone — authority is a property of connectivity, provenance, and governance, not of identity", "words": ["Treats", "any", "node", "as", "authoritative", "by", "virtue", "of", "its", "source", "alone", "authority", "is", "a", "property", "of", "connectivity", "provenance", "and", "governance", "not", "of", "identity"]}], "spans": [{"id": "mk:What the System Never Does/7.1", "kind": "bold", "covers": ["wrd:What the System Never Does/7.1.1", "wrd:What the System Never Does/7.1.2", "wrd:What the System Never Does/7.1.3", "wrd:What the System Never Does/7.1.4", "wrd:What the System Never Does/7.1.5"]}]}, {"id": "blk:What the System Never Does/8", "kind": "rule", "range": [27941, 27944], "text": "---"}]}
